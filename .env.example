# ── Timezone and lookahead ────────────────────────────────────────────────────
TZ=America/Chicago
LOOKAHEAD_DAYS=2
ARRIVAL_WINDOW_START=10:30
ARRIVAL_WINDOW_END=11:30

# ── Ticketmaster Discovery API ────────────────────────────────────────────────
# Register at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_key_here

# Target Field venue ID on Ticketmaster (optional but recommended for accuracy).
# Look it up with:
#   curl "https://app.ticketmaster.com/discovery/v2/venues.json?apikey=YOUR_KEY&keyword=Target+Field&city=Minneapolis"
TARGET_FIELD_VENUE_ID=

# ── Email notification (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sending_address@gmail.com
# Use an App Password, not your account password:
# https://support.google.com/accounts/answer/185833
SMTP_PASS=your_app_password_here
NOTIFY_EMAIL=recipient@example.com

# ── ntfy push notification (optional) ────────────────────────────────────────
# Leave blank to skip. Self-hosted: set NTFY_BASE_URL to your server URL.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh

# ── Development ───────────────────────────────────────────────────────────────
# Set to 1 to print the digest without sending any notifications
DRY_RUN=0
# Set to 0 to disable email (ntfy will still run if NTFY_TOPIC is set)
ENABLE_EMAIL=1
# Set to 1 to write docs/index.html for GitHub Pages
PUBLISH_HTML=0
HTML_OUTPUT_PATH=docs/index.html
